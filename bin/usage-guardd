#!/usr/bin/env python3
import os
import sys

# In the repo the package is next to bin/; once installed, in ~/.local/share/usage-guard.
here = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if not os.path.isdir(os.path.join(here, "usage_guard")):
    here = os.path.expanduser("~/.local/share/usage-guard")
sys.path.insert(0, here)

from usage_guard.daemon import main  # noqa: E402

sys.exit(main())
